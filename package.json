{
  "name": "open-flow-workspace",
  "private": true,
  "packageManager": "bun@1.4.2",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@oxc-node/core": "1.0.1",
    "oxfmt": "^0.60.0",
    "wrangler": "4.132.0"
  },
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "build:designer": "bun run --filter @oomol-lab/open-flow designer:build",
    "check": "bun run format -- --check && bun run check:locales && bun run --workspaces --if-present check",
    "check:locales": "node --test scripts/locale-files.test.mjs",
    "dev": "bun run dev:server",
    "dev:designer": "bun run --filter @oomol-lab/open-flow designer:dev",
    "dev:server": "bun run --cwd apps/server dev",
    "deploy:designer": "bun run --filter @oomol-lab/open-flow designer:deploy",
    "format": "oxfmt .",
    "lint": "bun run --workspaces --if-present lint",
    "test": "bun run --workspaces --if-present test",
    "test:coverage": "bun run --workspaces --if-present test:coverage",
    "test:docker": "bun run --filter @oomol-lab/open-flow-server test:docker",
    "test:npm-package": "bun run --filter @oomol-lab/open-flow test:package",
    "test:package": "bun run test:npm-package",
    "lab": "node --no-node-snapshot --import @oxc-node/core/register apps/server/scripts/lab/main.ts",
    "flow": "bun apps/server/scripts/flow.ts",
    "skill:generate": "bun run --filter @oomol-lab/open-flow skill:generate"
  }
}
