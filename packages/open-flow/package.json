{
  "name": "@oomol-lab/open-flow",
  "version": "0.1.0-alpha.10",
  "description": "Portable contracts and shared browser runtime for Open Flow.",
  "keywords": [
    "ai",
    "automation",
    "workflow"
  ],
  "homepage": "https://github.com/oomol-lab/open-flow#readme",
