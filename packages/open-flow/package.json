    "./designer-vite-config": "./src/build/node/designerUnoConfig.ts",
    "./integration-trigger": "./src/trigger/common/integration.ts",
    "./poll-trigger": "./src/trigger/common/poll.ts",
    "./provider-triggers": "./src/trigger/providers/definitions.ts",
    "./flow-authoring": "./src/flow/common/authoring.ts",
    "./flow-change": "./src/flow/common/change.ts",
    "./flow-encoding": "./src/flow/common/encoding.ts",
    "./flow-semantics": "./src/flow/common/semantics.ts",
    "./run-lifecycle": "./src/execution/common/runLifecycle.ts",
    "./run-events": "./src/execution/common/events.ts",
    "./runtime-contract": "./src/execution/common/runtime.ts",
    "./scheduler": "./src/execution/common/scheduler.ts",
    "./theme.css": "./src/ui/browser/theme.css",
    "./webhook-trigger": "./src/trigger/common/webhook.ts",
    "./workbench": "./src/workbench/browser/runtime/openFlowWorkbench.tsx"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run format -- --check && bun run lint && bun run check:types && bun run check:boundaries",
    "check:boundaries": "bun scripts/check-platform-boundaries.ts",
    "check:types": "tsc --noEmit",
    "designer:dev": "vite --config dev/designer/vite.config.ts",
    "format": "oxfmt README.md NOTICE src test scripts dev vitest.config.ts package.json tsconfig.json",
    "lint": "oxlint --deny-warnings src test scripts dev vitest.config.ts",
    "test": "bun run test:vitest",
    "test:coverage": "vitest run --config vitest.config.ts --coverage src/flow/common test/flow-encoding.test.ts test/flow-semantics.test.ts test/provider-triggers.test.ts test/run-events.test.ts test/scheduler.test.ts",
    "test:vitest": "vitest run --config vitest.config.ts src test",
    "test:package": "bun scripts/check-npm-package.ts"
  },
