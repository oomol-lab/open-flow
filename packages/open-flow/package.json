    "directory": "packages/open-flow"
  },
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "exports": {
    "./connector-action": "./src/connector/common/actionSchema.ts",
    "./connector-proxy": "./src/connector/common/proxy.ts",
    "./control-api": "./src/control/common/api.ts",
    "./control-api-conformance": "./src/control/common/conformance.ts",
    "./cron-trigger": "./src/trigger/common/cron.ts",
    "./designer-css-modules": "./src/build/node/cssModules.ts",
